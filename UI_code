# ---------------- ROCK ----------------

class RockSample(QGraphicsRectItem):

    def __init__(self, x, y, size_cm, color_str, temp):

        display_size = size_cm * SCALE

        super().__init__(
            0,
            0,
            display_size,
            display_size
        )

        self.setPos(
            x * SCALE - display_size / 2,
            y * SCALE - display_size / 2
        )

        self.setBrush(QBrush(QColor(color_str)))
        self.setPen(QPen(Qt.GlobalColor.black))

        self.setToolTip(
            f"Rock\n"
            f"Color: {color_str}\n"
            f"Size: {size_cm}cm\n"
            f"Temp: {temp}°C"
        )

# ---------------- MQTT ----------------

class MQTTWorker(QThread):

    message_received = pyqtSignal(str, str)

    def __init__(self, robot_name, username, password, topic):

        super().__init__()

        self.robot_name = robot_name

        self.client = mqtt.Client(
            mqtt.CallbackAPIVersion.VERSION2
        )

        self.client.username_pw_set(
            username,
            password
        )

        self.topic = topic

    def run(self):

        BROKER = "mqtt.ics.ele.tue.nl"

        def on_message(client, userdata, msg):

            payload = msg.payload.decode("utf-8")

            self.message_received.emit(
                self.robot_name,
                payload
            )

        self.client.on_message = on_message

        self.client.connect(BROKER, 1883, 60)

        self.client.subscribe(self.topic)

        self.client.loop_forever()

    def publish_message(self, topic, payload):

        self.client.publish(topic, payload)

# ---------------- DASHBOARD ----------------

class VenusDashboard(QMainWindow):

    def __init__(self):

        super().__init__()

        self.setWindowTitle(
            "Venus Exploration Ground Station"
        )

        self.resize(1300, 1000)

        self.setStyleSheet(STYLESHEET)

        central_widget = QWidget()

        self.setCentralWidget(central_widget)

        main_layout = QHBoxLayout(central_widget)

        left_col = QWidget()
        left_layout = QVBoxLayout(left_col)

        right_col = QWidget()
        right_layout = QVBoxLayout(right_col)

        main_layout.addWidget(left_col, stretch=3)
        main_layout.addWidget(right_col, stretch=1)

        self.setup_map_panel(left_layout)
        self.setup_log_panel(left_layout)

        self.setup_telemetry_panel(right_layout)
        self.setup_findings_panel(right_layout)
        self.setup_controls_panel(right_layout)

        # Timers

        self.timer41 = QTimer()
        self.timer80 = QTimer()

        self.timer41.timeout.connect(
            lambda: self.set_offline("Robot41")
        )

        self.timer80.timeout.connect(
            lambda: self.set_offline("Robot80")
        )

        # MQTT

        self.workerA = MQTTWorker(
            "Robot41",
            "robot_41_1",
            "t7gIhbJF",
            "/pynqbridge/41/send"
        )

        self.workerB = MQTTWorker(
            "Robot80",
            "robot_80_1",
            "OQfY8Km2",
            "/pynqbridge/80/send"
        )

        self.workerA.message_received.connect(
            self.handle_message
        )

        self.workerB.message_received.connect(
            self.handle_message
        )

        self.workerA.start()
        self.workerB.start()

    # ---------------- UI ----------------

    def setup_map_panel(self, parent_layout):

        group = QGroupBox("Explore Venus")

        layout = QVBoxLayout(group)

        self.scene = QGraphicsScene(
            -150 * SCALE,
            -150 * SCALE,
            300 * SCALE,
            300 * SCALE
        )

        self.view = QGraphicsView(self.scene)

        self.view.setBackgroundBrush(
            QBrush(QColor("#1e1e1e"))
        )

        self.view.setRenderHint(
            QPainter.RenderHint.Antialiasing
        )

        layout.addWidget(self.view)

        parent_layout.addWidget(group, stretch=2)

        self.draw_guides()
        self.initialize_robots()

    def setup_log_panel(self, parent_layout):

        group = QGroupBox("Logs")

        layout = QVBoxLayout(group)

        self.log_widget = QTextBrowser()

        layout.addWidget(self.log_widget)

        parent_layout.addWidget(group, stretch=1)

    def setup_telemetry_panel(self, parent_layout):

        group = QGroupBox("Telemetry")

        layout = QVBoxLayout(group)

        self.status_41_label = QLabel("OFFLINE")
        self.pos_41_label = QLabel("(---, ---)")

        layout.addWidget(QLabel("Robot41"))
        layout.addWidget(self.status_41_label)
        layout.addWidget(self.pos_41_label)

        self.status_80_label = QLabel("OFFLINE")
        self.pos_80_label = QLabel("(---, ---)")

        layout.addWidget(QLabel("Robot80"))
        layout.addWidget(self.status_80_label)
        layout.addWidget(self.pos_80_label)

        parent_layout.addWidget(group)

    def setup_findings_panel(self, parent_layout):

        group = QGroupBox("Discoveries")

        layout = QVBoxLayout(group)

        self.findings_list = QListWidget()

        layout.addWidget(self.findings_list)

        parent_layout.addWidget(group)

    def setup_controls_panel(self, parent_layout):

        group = QGroupBox("Controls")

        layout = QVBoxLayout(group)

        btn_fit = QPushButton("Zoom Fit")
        btn_fit.clicked.connect(self.zoom_to_fit)

        btn_clear = QPushButton("Clear")
        btn_clear.clicked.connect(self.clear_all)

        layout.addWidget(btn_fit)
        layout.addWidget(btn_clear)

        parent_layout.addWidget(group)

    # ---------------- MAP ----------------

    def draw_guides(self):

        grid_pen = QPen(QColor(80, 80, 80, 50))

        for i in range(-150, 151, 10):

            self.scene.addLine(
                i * SCALE,
                -150 * SCALE,
                i * SCALE,
                150 * SCALE,
                grid_pen
            )

            self.scene.addLine(
                -150 * SCALE,
                i * SCALE,
                150 * SCALE,
                i * SCALE,
                grid_pen
            )

    def initialize_robots(self):

        self.robot41_marker = self.scene.addEllipse(
            0,
            0,
            ROBOT_SIZE,
            ROBOT_SIZE,
            QPen(Qt.GlobalColor.white),
            QBrush(QColor("blue"))
        )

        self.robot80_marker = self.scene.addEllipse(
            0,
            0,
            ROBOT_SIZE,
            ROBOT_SIZE,
            QPen(Qt.GlobalColor.white),
            QBrush(QColor("green"))
        )

        self.robot41_marker.setPos(
            -ROBOT_SIZE / 2,
            -ROBOT_SIZE / 2
        )

        self.robot80_marker.setPos(
            -ROBOT_SIZE / 2,
            -ROBOT_SIZE / 2
        )

        # Orientation

        self.robot41_angle = 0
        self.robot80_angle = 0

        # Direction markers

        self.robot41_dir = self.scene.addLine(
            0, 0, 0, -20,
            QPen(QColor("white"), 2)
        )

        self.robot80_dir = self.scene.addLine(
            0, 0, 0, -20,
            QPen(QColor("white"), 2)
        )

        self.update_direction_marker("Robot41")
        self.update_direction_marker("Robot80")

    # ---------------- ORIENTATION ----------------

    def update_direction_marker(self, robot_name):

        if robot_name == "Robot41":

            robot = self.robot41_marker
            line = self.robot41_dir
            angle_deg = self.robot41_angle

        else:

            robot = self.robot80_marker
            line = self.robot80_dir
            angle_deg = self.robot80_angle

        center = robot.sceneBoundingRect().center()

        angle = math.radians(angle_deg)

        radius = ROBOT_SIZE / 2

        end_x = center.x() + radius * math.sin(angle)
        end_y = center.y() - radius * math.cos(angle)

        line.setLine(
            center.x(),
            center.y(),
            end_x,
            end_y
        )

    def rotate_robot(self, robot_name, delta):

        if robot_name == "Robot41":
            self.robot41_angle += delta
        else:
            self.robot80_angle += delta

        self.update_direction_marker(robot_name)

    # ---------------- MESSAGE HANDLER ----------------

    def handle_message(self, robot_name, text):

        time_str = datetime.now().strftime("%H:%M:%S")

        self.log_widget.append(
            f"[{time_str}] [{robot_name}] {text}"
        )

        try:

            is_41 = robot_name == "Robot41"

            target = (
                self.robot41_marker
                if is_41
                else self.robot80_marker
            )

            parts = text.strip().split(",")

            cmd = parts[0]

            # =========================================
            # ORIENTATION
            # =========================================

            if cmd == "ORT":

                ort = int(parts[1])
                theta = float(parts[2])

                angle = ((ort - 1) * 90.0) + theta

                if is_41:
                    self.robot41_angle = angle
                else:
                    self.robot80_angle = angle

                self.update_direction_marker(robot_name)


            # =========================================
            # STEPS
            # =========================================

            elif cmd == "STEPS":

                steps = float(parts[1])

                old_c = target.sceneBoundingRect().center()

                if is_41:
                    angle_deg = self.robot41_angle
                else:
                    angle_deg = self.robot80_angle

                angle = math.radians(angle_deg)

                # MATCHES THE NOTCH DIRECTION
                dx = steps * SCALE * math.sin(angle)
                dy = -steps * SCALE * math.cos(angle)

                nx = old_c.x() + dx
                ny = old_c.y() + dy

                target.setPos(
                    nx - ROBOT_SIZE / 2,
                    ny - ROBOT_SIZE / 2
                )

                self.update_direction_marker(robot_name)

                label = (
                    self.pos_41_label
                    if is_41
                    else self.pos_80_label
                )

                label.setText(
                    f"({round(nx/SCALE,1)}, "
                    f"{round(ny/SCALE,1)})"
                )
            # =========================================
            # ROCK
            # =========================================

            elif cmd == "ROCK":

                x = float(parts[1])
                y = float(parts[2])

                sz = int(parts[3])

                col = parts[4]

                temp = float(parts[5])

                self.scene.addItem(
                    RockSample(
                        x,
                        y,
                        sz,
                        col,
                        temp
                    )
                )

                self.findings_list.addItem(
                    f"{robot_name}: "
                    f"{col} rock | "
                    f"{sz}cm | "
                    f"{temp}°C"
                )

            # =========================================
            # ONLINE STATUS
            # =========================================

            if is_41:

                self.status_41_label.setText("ONLINE")

                self.timer41.start(3000)

            else:

                self.status_80_label.setText("ONLINE")

                self.timer80.start(3000)

        except Exception as e:

            self.log_widget.append(
                f"ERROR: {e}"
            )

    def set_offline(self, robot_name):

        if robot_name == "Robot41":
            self.status_41_label.setText("OFFLINE")
        else:
            self.status_80_label.setText("OFFLINE")

    def zoom_to_fit(self):

        rect = self.scene.itemsBoundingRect()

        if not rect.isNull():

            rect.adjust(-50, -50, 50, 50)

            self.view.fitInView(
                rect,
                Qt.AspectRatioMode.KeepAspectRatio
            )

    def clear_all(self):

        self.scene.clear()

        self.draw_guides()
        self.initialize_robots()

        self.log_widget.clear()
        self.findings_list.clear()

# ---------------- MAIN ----------------

if __name__ == "__main__":

    app = QApplication(sys.argv)

