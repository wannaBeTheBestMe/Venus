/* --------------------------------------------------
   GO AROUND OBJECT
   -------------------------------------------------- */
void go_around_object(Robot *r) {
    turn_left_90(r);
    move_forward_unit(r, 4);

    turn_right_90(r);
    move_forward_unit(r, 4);

    turn_right_90(r);
    move_forward_unit(r, 4);

    turn_left_90(r);
}

/* --------------------------------------------------
   STEP 1:
   SEARCH FOR BOUNDARY
   -------------------------------------------------- */
void search_for_boundary(Robot *r1, Robot *r2) {
    printf("%s searching for boundary...\n", r1->name);
    printf("%s remains idle at (%d, %d)\n", r2->name, r2->pos.x, r2->pos.y);

    if (detect_black_boundary()) {
        stop_robot();
        r1->state = STATE_ALIGN_BOUNDARY;
        printf("Boundary detected.\n");
    }
    else if (detect_obstacle()) {
        printf("Obstacle detected. Going around it...\n");
        go_around_object(r1);
    }
    else {
        move_forward_unit(r1, 1);
    }
}

/* --------------------------------------------------
   STEP 2:
   ALIGN AND TRACE BOUNDARY
   -------------------------------------------------- */
void orient_parallel_to_boundary(Robot *r1) {
    turn_left_90(r1);
    r1->state = STATE_TRACE_BOUNDARY;
    printf("%s aligned parallel to boundary.\n", r1->name);
}

int returned_to_start(Position start, Position current) {
    if (start.x == current.x && start.y == current.y) {
        return 1;
    }
    return 0;
}

void trace_boundary(Robot *r1, GridMap *map) {
    static int started = 0;
    static Position startPos;
    static int firstLoop = 1;

    if (!started) {
        startPos = r1->pos;
        map->boundaryCount = 0;
        started = 1;
        firstLoop = 1;
    }

    move_forward_unit(r1, 1);

    if (map->boundaryCount < MAX_BOUNDARY_POINTS) {
        map->boundaryX[map->boundaryCount] = r1->pos.x;
        map->boundaryY[map->boundaryCount] = r1->pos.y;
        map->boundaryCount++;
    }

    if (map->boundaryCount > 20) {
        firstLoop = 0;
    }

    if (!firstLoop && returned_to_start(startPos, r1->pos)) {
        stop_robot();
        r1->state = STATE_PREPARE_GRID;
        started = 0;
        printf("Boundary traced completely.\n");
        return;
    }

    if (!detect_black_boundary()) {
        turn_right_90(r1);
    }
}

/* --------------------------------------------------
   STEP 3:
   BUILD SIMPLE GRID MAP
   -------------------------------------------------- */
void prepare_grid_map(Robot *r1, Robot *r2, GridMap *map) {
    int i, row, col;

    map->minX = map->boundaryX[0];
    map->maxX = map->boundaryX[0];
    map->minY = map->boundaryY[0];
    map->maxY = map->boundaryY[0];

    for (i = 1; i < map->boundaryCount; i++) {
        if (map->boundaryX[i] < map->minX) map->minX = map->boundaryX[i];
        if (map->boundaryX[i] > map->maxX) map->maxX = map->boundaryX[i];
        if (map->boundaryY[i] < map->minY) map->minY = map->boundaryY[i];
        if (map->boundaryY[i] > map->maxY) map->maxY = map->boundaryY[i];
    }

    map->width = map->maxX - map->minX;
    map->height = map->maxY - map->minY;

    map->rows = map->height / CELL_SIZE_CM;
    map->cols = map->width / CELL_SIZE_CM;

    if (map->rows > MAX_ROWS) map->rows = MAX_ROWS;
    if (map->cols > MAX_COLS) map->cols = MAX_COLS;

    for (row = 0; row < map->rows; row++) {
        for (col = 0; col < map->cols; col++) {
            map->cells[row][col].row = row;
            map->cells[row][col].col = col;
            map->cells[row][col].state = 0;
            strcpy(map->cells[row][col].label, "");
        }
    }

    printf("Boundary dimensions: width = %d, height = %d\n", map->width, map->height);
    printf("R1 relative position: (%d, %d)\n", r1->pos.x - map->minX, r1->pos.y - map->minY);
    printf("R2 relative position: (%d, %d)\n", r2->pos.x - map->minX, r2->pos.y - map->minY);
    printf("Grid created: %d rows x %d cols, cell size = %.2f cm\n",
           map->rows, map->cols, CELL_SIZE_CM);

    r1->state = STATE_DONE;
}

/* --------------------------------------------------
   MAIN
   -------------------------------------------------- */
int main(void) {
    pynq_init();

    stepper_init();
    stepper_enable();

    gpio_set_direction(S0, GPIO_DIR_OUTPUT);
    gpio_set_direction(S1, GPIO_DIR_OUTPUT);
    gpio_set_direction(S2, GPIO_DIR_OUTPUT);
    gpio_set_direction(S3, GPIO_DIR_OUTPUT);
    gpio_set_direction(SENSOR_OUT, GPIO_DIR_INPUT);

    gpio_set_level(S0, GPIO_LEVEL_HIGH);
    gpio_set_level(S1, GPIO_LEVEL_LOW);

    Robot R1, R2;
    GridMap map;

    init_robot(&R1, "R1", 0, 0, DIR_EAST, STATE_SEARCH_BOUNDARY);
    init_robot(&R2, "R2", 0, 0, DIR_EAST, 0);

    while (1) {
        if (R1.state == STATE_SEARCH_BOUNDARY) {
            search_for_boundary(&R1, &R2);
        }
        else if (R1.state == STATE_ALIGN_BOUNDARY) {
            orient_parallel_to_boundary(&R1);
        }
        else if (R1.state == STATE_TRACE_BOUNDARY) {
            trace_boundary(&R1, &map);
        }
        else if (R1.state == STATE_PREPARE_GRID) {
            prepare_grid_map(&R1, &R2, &map);
        }
        else if (R1.state == STATE_DONE) {
            printf("Steps 1 to 3 complete.\n");
            break;
        }

        sleep_msec(100);
    }

    stepper_destroy();
    pynq_destroy();
    return 0;
}
